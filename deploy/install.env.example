# Copy to a per-host file and pass: sudo ./install.sh --non-interactive --env thisfile
# For a fleet, keep one file per VPS (never commit real secrets).

ROOT_DOMAIN=example.com
ACME_EMAIL=you@example.com

IP_TX=203.0.113.10
IP_MKT=203.0.113.11
IP_CANARY=203.0.113.12

# Optional — generated if omitted
