# Unattended: sudo ./install.sh --non-interactive --env thisfile
# Only ROOT_DOMAIN is required. IPs are detected on the host.
# Passwords are generated if omitted.

ROOT_DOMAIN=example.com
ACME_EMAIL=you@example.com
AUTO_DETECT_IPS=true
DRY_RUN=true

# Pin IPs instead of detecting:
# IPS=203.0.113.10,203.0.113.11,203.0.113.12

# Or pin pools:
# POOL_TX=203.0.113.10
# POOL_MKT=203.0.113.11,203.0.113.12
# POOL_CANARY=203.0.113.13
