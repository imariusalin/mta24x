{
	email {$ACME_EMAIL:admin@localhost}
}

{$MAIL_HOSTNAME:mail.example.com} {
	handle /v1/* {
		reverse_proxy unix//sock/http.sock
	}
	handle /console* {
		reverse_proxy unix//sock/http.sock
	}
	handle /u/* {
		reverse_proxy unix//sock/http.sock
	}
	handle /health {
		reverse_proxy unix//sock/http.sock
	}
	handle /.well-known/mta-sts.txt {
		reverse_proxy unix//sock/http.sock
	}
	handle {
		# Prefer webmail; if that container is down, serve the engine so the
		# hostname is never a blank 502.
		reverse_proxy webmail:3000 unix//sock/http.sock {
			lb_policy first
			fail_duration 10s
			max_fails 1
			transport http {
				dial_timeout 3s
			}
		}
	}
}

mta-sts.{$ROOT_DOMAIN:example.com} {
	handle /.well-known/mta-sts.txt {
		reverse_proxy unix//sock/http.sock
	}
	handle {
		reverse_proxy unix//sock/http.sock
	}
}
