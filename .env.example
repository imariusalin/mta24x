# Copy to .env and fill in. Engine reads this file.

ROOT_DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com
API_PUBLIC_URL=https://mail.example.com
ADMIN_PASSWORD=change-me-now
ACME_EMAIL=you@example.com
SESSION_SECRET=change-this-session-secret
STALWART_ADMIN_PASSWORD=change-me-now
POSTGRES_PASSWORD=mta

# Sending IPs — any count (1, 3, 200, …).
# Installer auto-detects host IPv4s into IPS= unless you pin them.
# Split: 1 IP = shared; 2 = tx+mkt; 3 = tx/mkt/canary; 4+ = ~20% tx, ~10% canary, rest marketing.
IPS=203.0.113.10,203.0.113.11,203.0.113.12
AUTO_DETECT_IPS=true

# Optional explicit pools (overrides automatic split of IPS):
# POOL_TX=203.0.113.10
# POOL_MKT=203.0.113.11,203.0.113.12
# POOL_CANARY=203.0.113.13

HTTP_BIND=0.0.0.0:8787
SMTP_IN_BIND=0.0.0.0:2525
WORKER_CONCURRENCY=16

# true until DNS/PTR/DKIM are live. Then set false.
DRY_RUN=true

DATABASE_URL=postgres://mta:mta@127.0.0.1:5432/mta
