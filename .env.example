# Copy to .env and fill in. Engine reads this file.

ROOT_DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com
API_PUBLIC_URL=https://mail.example.com
ADMIN_PASSWORD=change-me-now
ACME_EMAIL=you@example.com
SESSION_SECRET=change-this-session-secret
STALWART_ADMIN_PASSWORD=change-me-now
POSTGRES_PASSWORD=mta

# Three public IPs on the VPS. PTR of each MUST equal the EHLO hostname.
IP_TX=203.0.113.10
IP_TX_EHLO=mail.example.com
IP_MKT=203.0.113.11
IP_MKT_EHLO=news-out.example.com
IP_CANARY=203.0.113.12
IP_CANARY_EHLO=out.example.com

HTTP_BIND=0.0.0.0:8787
SMTP_IN_BIND=0.0.0.0:2525
WORKER_CONCURRENCY=16

# true until DNS/PTR/DKIM are live. Then set false.
DRY_RUN=true

DATABASE_URL=postgres://mta:mta@127.0.0.1:5432/mta
